{
  "manifest_version": 3,
  "name": "Hashling",
  "version": "1.0.0",
  "description": "A cyber-pet that catches scams, phishing and malware while you browse, and grows as you get smarter about security.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>", "http://localhost:8000/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Hashling",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["hashling.js", "content.js"], "run_at": "document_idle" },
    { "matches": ["https://mail.google.com/*", "http://localhost:5173/*"], "js": ["hashling.js", "gmail.js"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [{
    "resources": [
      "warning.css",
      "assets/hashling/pixel/hashling-egg.png",
      "assets/hashling/pixel/hashling-kitten-idle.png",
      "assets/hashling/pixel/hashling-kitten-idle-moss.png",
      "assets/hashling/pixel/hashling-kitten-idle-amber.png",
      "assets/hashling/pixel/hashling-kitten-idle-cyan.png",
      "assets/hashling/pixel/hashling-kitten-happy.png",
      "assets/hashling/pixel/hashling-kitten-happy-moss.png",
      "assets/hashling/pixel/hashling-kitten-happy-amber.png",
      "assets/hashling/pixel/hashling-kitten-happy-cyan.png",
      "assets/hashling/pixel/hashling-kitten-sleep.png",
      "assets/hashling/pixel/hashling-kitten-sleep-moss.png",
      "assets/hashling/pixel/hashling-kitten-sleep-amber.png",
      "assets/hashling/pixel/hashling-kitten-sleep-cyan.png",
      "assets/hashling/pixel/hashling-cub-idle.png",
      "assets/hashling/pixel/hashling-cub-idle-moss.png",
      "assets/hashling/pixel/hashling-cub-idle-amber.png",
      "assets/hashling/pixel/hashling-cub-idle-cyan.png",
      "assets/hashling/pixel/hashling-cub-happy.png",
      "assets/hashling/pixel/hashling-cub-happy-moss.png",
      "assets/hashling/pixel/hashling-cub-happy-amber.png",
      "assets/hashling/pixel/hashling-cub-happy-cyan.png",
      "assets/hashling/pixel/hashling-cub-sleep.png",
      "assets/hashling/pixel/hashling-cub-sleep-moss.png",
      "assets/hashling/pixel/hashling-cub-sleep-amber.png",
      "assets/hashling/pixel/hashling-cub-sleep-cyan.png",
      "assets/hashling/pixel/hashling-adult-idle.png",
      "assets/hashling/pixel/hashling-adult-idle-moss.png",
      "assets/hashling/pixel/hashling-adult-idle-amber.png",
      "assets/hashling/pixel/hashling-adult-idle-cyan.png",
      "assets/hashling/pixel/hashling-adult-happy.png",
      "assets/hashling/pixel/hashling-adult-happy-moss.png",
      "assets/hashling/pixel/hashling-adult-happy-amber.png",
      "assets/hashling/pixel/hashling-adult-happy-cyan.png",
      "assets/hashling/pixel/hashling-adult-sleep.png",
      "assets/hashling/pixel/hashling-adult-sleep-moss.png",
      "assets/hashling/pixel/hashling-adult-sleep-amber.png",
      "assets/hashling/pixel/hashling-adult-sleep-cyan.png",
      "assets/hashling/pixel/wearables/hat_sprout.png",
      "assets/hashling/pixel/wearables/hat_visor.png",
      "assets/hashling/pixel/wearables/hat_flower.png",
      "assets/hashling/pixel/wearables/hat_antenna.png",
      "assets/hashling/pixel/wearables/collar_bell.png",
      "assets/hashling/pixel/wearables/collar_vine.png",
      "assets/hashling/pixel/wearables/collar_led.png",
      "assets/hashling/pixel/wearables/acc_solar.png",
      "assets/hashling/pixel/wearables/acc_glass.png",
      "assets/hashling/pixel/wearables/acc_shield.png"
    ],
    "matches": ["<all_urls>"]
  }]
}
